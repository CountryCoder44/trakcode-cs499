# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Environment files (never commit real secrets — .env.example files ARE tracked)
.env
.env.*
!.env.example
!.env.*.example

# Logs
npm-debug.log*
*.log

# Editor / OS
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# Test / coverage
coverage/

# Local persistent dev database (server/src/config/db.ts, MONGODB_URI=memory://...?persist=true)
.mongo-data/

# Local admin credentials (generated by a one-off reset, never commit)
admin-credentials.txt

# API keys / secrets that might land outside a .env file — never commit
*.key
*api*key*.txt
*API*KEY*.txt
elevenlabs*.txt

# TTS generation scratch space (see Sequential Curriculum/AUDIO.md).
# The reviewed scripts and the finished clips ARE committed; only .tmp is not.
Sequential Curriculum/**/audio/.tmp/
# Free Windows-SAPI placeholder narration — local review only, never committed.
# The real ElevenLabs .mp3 clips are committed.
Sequential Curriculum/**/audio/clips/*.wav

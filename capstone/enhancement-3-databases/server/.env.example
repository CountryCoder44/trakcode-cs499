# Copy this file to .env.dev, .env.capstone-submission, or .env.production (in this
# server/ directory) and fill in real values. NODE_ENV picks which one gets loaded —
# see src/config/env.ts. In deployed environments (ECS Fargate / Elastic Beanstalk),
# these are normally injected directly by the platform instead of read from a file.
#
# Per spec §2 open decision (resolved): capstone-submission uses its OWN MongoDB
# database/cluster, separate from dev and production. Put a DIFFERENT MONGODB_URI in
# each environment's file — never point capstone-submission at the prod cluster.

NODE_ENV=dev                 # dev | capstone-submission | production
PORT=4000

MONGODB_URI=mongodb://localhost:27017/trakcode_dev
JWT_SECRET=replace-with-a-long-random-string

# Stripe — not wired until Week 8, leave blank for now
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=

# GitHub OAuth — register a separate OAuth App per environment (different callback
# URLs), required for the /api/auth/github/* routes to work
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# AI services — used by the problem-generation pipeline (§5) and, from Week 5,
# the AI tutor (§6). Leave AI_MODEL blank to use the code's default
# (claude-opus-5, the current recommended model — the spec's example value of
# claude-sonnet-4-6 predates newer models).
AI_API_KEY=
AI_MODEL=

AWS_REGION=
S3_BUCKET=
EXECUTION_SERVICE_URL=

# Admin endpoints (e.g. POST /admin/demo-codes, not built yet — see seed script instead)
DEMO_CODE_ADMIN_KEY=replace-with-an-admin-secret

# --- Additions beyond the spec's §2 list, needed to make Week 1 auth functional ---

# Symmetric key for encrypting githubAccessToken at rest (§3.1). Falls back to
# JWT_SECRET if unset — set a distinct value in every real deployment.
ENCRYPTION_KEY=

# Where to send the browser after a GitHub OAuth callback completes.
FRONTEND_URL=http://localhost:5173

# --- Lesson narration (TTS) for the Sequential Curriculum ---
# See "Sequential Curriculum/AUDIO.md". `npm run tts:scripts` prepares the
# per-instruction narration scripts with no key. `npm run tts:generate` then
# produces audio via TTS_PROVIDER:
#   sapi        free, offline Windows Speech API — rough placeholder voice for
#               reviewing lessons; writes .wav clips (gitignored). No cost.
#   elevenlabs  the paid Trak voice — needs TTS_ENABLED=true AND
#               ELEVENLABS_API_KEY AND ELEVENLABS_VOICE_ID; writes .mp3 clips.
TTS_ENABLED=false
TTS_PROVIDER=elevenlabs
SAPI_VOICE=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

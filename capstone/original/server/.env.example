# =============================================================================
# TrakCode API — example environment file
# =============================================================================
# Copy this file to `server/.env.dev` and fill in values for the features you
# want to exercise. `NODE_ENV` selects which `.env.<NODE_ENV>` file is loaded
# (see src/config/env.ts). In a real deployment these values would be injected
# by the hosting platform rather than read from a file.
#
# DO NOT COMMIT a real `.env.dev` — `.gitignore` already excludes it.
# Every value below is a placeholder. Replace with your own local values.
# =============================================================================

NODE_ENV=dev                 # dev | capstone-submission | production
PORT=4000

# --- Database -----------------------------------------------------------------
# Zero-setup local option (recommended for review): spins up a real MongoDB
# process in-memory via `mongodb-memory-server`, with data persisted on disk
# under server/.mongo-data/ (gitignored) so accounts survive restarts.
MONGODB_URI=memory://trakcode_dev?persist=true
# Alternative: point at a MongoDB instance you run yourself.
# MONGODB_URI=mongodb://localhost:27017/trakcode

# --- Auth -------------------------------------------------------------------
# Any random string of 16+ characters works for local development.
JWT_SECRET=replace_with_local_development_secret

# --- Stripe billing (optional) ----------------------------------------------
# Leave blank to run without billing. Billing routes return a clear 503 until
# these are set. Never place real keys here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=

# --- GitHub OAuth (optional) ----------------------------------------------
# Needed only for the /api/auth/github/* routes and portfolio push. Register
# your own OAuth App and use its credentials. Leave blank to run without it.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# --- AI services (optional) ----------------------------------------------
# Used by the AI problem-generation pipeline and the AI tutor. Leave blank to
# run the core Learn/Practice flow without AI (seeded content is used instead).
# Supply your own Anthropic API key to enable AI features.
AI_API_KEY=your_anthropic_api_key_here
# Optional override for the reasoning-tier model; blank uses the code default.
AI_MODEL=

# --- Object storage (optional, not currently wired to any route) -----------
AWS_REGION=
S3_BUCKET=

# --- Internal code-execution service --------------------------------------
EXECUTION_SERVICE_URL=http://localhost:4100

# --- Admin ----------------------------------------------------------------
# Shared secret for the admin-key-gated demo-code endpoint. Choose any local
# value; this is NOT a user login.
DEMO_CODE_ADMIN_KEY=replace_with_local_admin_secret

# --- Additional keys ----------------------------------------------------
# Symmetric key used to encrypt a linked GitHub access token at rest. Falls
# back to JWT_SECRET when unset — set a distinct value in any real deployment.
ENCRYPTION_KEY=
# Where the browser is sent after the GitHub OAuth callback completes.
FRONTEND_URL=http://localhost:5173

# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Environment files (never commit real secrets — .env.example files ARE tracked)
.env
.env.*
!.env.example
!.env.*.example

# Logs
npm-debug.log*
*.log

# Editor / OS / local tooling
.vscode/*
!.vscode/extensions.json
.claude/
.DS_Store
Thumbs.db

# Test / coverage
coverage/

# Local persistent dev database (server/src/config/db.ts, MONGODB_URI=memory://...?persist=true)
.mongo-data/

# Local admin credentials (generated by a one-off reset, never commit)
admin-credentials.txt

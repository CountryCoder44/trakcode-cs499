# Copy this file to .env.dev, .env.capstone-submission, or .env.production (in this
# server/ directory) and fill in real values. NODE_ENV picks which one gets loaded —
# see src/config/env.ts. In deployed environments (ECS Fargate / Elastic Beanstalk),
# these are normally injected directly by the platform instead of read from a file.
#
# Per spec §2 open decision (resolved): capstone-submission uses its OWN MongoDB
# database/cluster, separate from dev and production. Put a DIFFERENT MONGODB_URI in
# each environment's file — never point capstone-submission at the prod cluster.

NODE_ENV=dev                 # dev | capstone-submission | production
PORT=4000

MONGODB_URI=mongodb://localhost:27017/trakcode_dev
JWT_SECRET=replace-with-a-long-random-string

# Stripe — not wired until Week 8, leave blank for now
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
# Stripe coupon: 20% off, duration "forever", for founding members.
STRIPE_FOUNDER_COUPON_ID=
# Public launch date (YYYY-MM-DD). Founding-member signups stay open until the end
# of the month 6 months after it. Leave empty until launch (window stays open).
FOUNDER_LAUNCH_DATE=

# Social sign-in (Google / GitHub / LinkedIn) — see README "Social sign-in setup".
# Each provider is optional: leave its id/secret empty and its button is hidden.
# Register this redirect URI with every provider: ${OAUTH_CALLBACK_BASE_URL}/<provider>/callback
OAUTH_CALLBACK_BASE_URL=http://localhost:4000/api/auth/oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LinkedIn Posts API version (YYYYMM). Each version is supported ~1 year; bump when it ages out.
LINKEDIN_API_VERSION=202606

# AI services — used by the problem-generation pipeline (§5) and, from Week 5,
# the AI tutor (§6). Leave AI_MODEL blank to use the code's default
# (claude-opus-5, the current recommended model — the spec's example value of
# claude-sonnet-4-6 predates newer models).
AI_API_KEY=
AI_MODEL=

AWS_REGION=
S3_BUCKET=
EXECUTION_SERVICE_URL=

# --- Additions beyond the spec's §2 list, needed to make Week 1 auth functional ---

# Symmetric key for encrypting githubAccessToken at rest (§3.1). Falls back to
# JWT_SECRET if unset — set a distinct value in every real deployment.
ENCRYPTION_KEY=

# Where to send the browser after social sign-in completes (lands on /auth/callback).
FRONTEND_URL=http://localhost:5173

# Outgoing email (password resets). Production: Google Workspace SMTP relay,
# which authorizes the server's IP instead of a password:
#   SMTP_HOST=smtp-relay.gmail.com  SMTP_PORT=587  (no SMTP_USER/SMTP_PASS)
# EMAIL_FROM must be a Workspace address or alias. Leave SMTP_HOST empty in
# dev: emails are printed to the server log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_HELO_NAME=trakcode.com
EMAIL_FROM=TrakCode <noreply@trakcode.com>
EMAIL_REPLY_TO=support@trakcode.com

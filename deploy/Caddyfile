# Caddy gets and renews the HTTPS certificate for SITE_DOMAIN automatically
# (Let's Encrypt), as soon as the domain's DNS points at this server.
{
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# API and health check go to the Express API.
	handle /api/* {
		reverse_proxy api:4000
	}
	handle /health {
		reverse_proxy api:4000
	}

	# Everything else is the React single-page app.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		# Built assets have content hashes in their names, so cache them forever.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# Everything else (index.html above all) must be re-checked on every
		# visit, or browsers keep showing the previous release after a deploy.
		@notAssets not path /assets/*
		header @notAssets Cache-Control "no-cache"
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
